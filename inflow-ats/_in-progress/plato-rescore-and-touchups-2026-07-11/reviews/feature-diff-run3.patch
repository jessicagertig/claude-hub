+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe Api::V1::AiJobApplicationSummariesController, type: :controller do
+  include ActiveJob::TestHelper
+  include Devise::Test::ControllerHelpers
+
+  around do |example|
+    original_adapter = ActiveJob::Base.queue_adapter
+    ActiveJob::Base.queue_adapter = :test
+    example.run
+    ActiveJob::Base.queue_adapter = original_adapter
+  end
+
+  let(:organization) { create_credit_test_organization }
+  let(:user) { organization.owner }
+  let(:organization_user) do
+    ou = credit_test_owner_organization_user(organization)
+    ou.update!(role: :org_admin) unless ou.org_admin? || ou.org_owner?
+    ou
+  end
+  let(:job_record) { create_credit_test_job(organization: organization) }
+
+  before do
+    Flipper.enable(:AI_APPLICANT_SUMMARY, organization)
+    organization.organization_ai_credit_balance.update!(monthly_credits_remaining: 100)
+
+    organization_user
+    user.update_column(:current_organization_user_id, organization_user.id)
+    user.reload
+
+    allow(controller).to receive(:authenticate_api_v1_user!)
+    allow(controller).to receive(:current_api_v1_user).and_return(user)
+    allow(controller).to receive(:current_user).and_return(user)
+    allow(controller).to receive(:set_sentry_context)
+  end
+
+  def job_application_with_textract
+    job_application = create_credit_test_job_application(job: job_record)
+    job_application.resume.attach(io: StringIO.new('fake'), filename: 'r.pdf', content_type: 'application/pdf')
+    TextractResult.create!(
+      job_application: job_application,
+      textract_job_result_text: "resume text #{SecureRandom.hex(4)}",
+      textract_job_id: "tx-#{SecureRandom.hex(4)}",
+      textract_job_status: :succeeded
+    )
+    job_application
+  end
+
+  describe '#create' do
+    it 'rejects a request without rescore_requested' do
+      job_application = job_application_with_textract
+      allow(ValidateAiSummaryGeneration).to receive(:call)
+        .and_return(double(success?: true, textract_result: job_application.latest_textract_result, textract_pending: false))
+
+      expect {
+        post :create, params: { job_application_id: job_application.id, ai_job_application_summary: { irrelevant: 'x' } }, format: :json
+      }.to raise_error(ActionController::ParameterMissing)
+    end
+
+    it 'threads rescore_requested onto the job_application before CreateAiSummaryGeneration' do
+      job_application = job_application_with_textract
+      ai_job_application_summary = job_application.ai_job_application_summaries.create!(
+        textract_result: job_application.latest_textract_result, status: :pending
+      )
+      allow(ValidateAiSummaryGeneration).to receive(:call)
+        .and_return(double(success?: true, textract_result: job_application.latest_textract_result, textract_pending: false))
+      captured_job_application = nil
+      allow(CreateAiSummaryGeneration).to receive(:call) do |args|
+        captured_job_application = args[:job_application]
+        double(success?: true, ai_summary: ai_job_application_summary)
+      end
+
+      post :create, params: {
+        job_application_id: job_application.id,
+        ai_job_application_summary: { rescore_requested: true }
+      }, format: :json
+
+      expect(response).to have_http_status(:ok)
+      expect(captured_job_application.ai_summary_rescore_requested).to be true
+    end
+  end
+end
