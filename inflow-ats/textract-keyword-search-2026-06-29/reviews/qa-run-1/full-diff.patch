@@ -0,0 +1,66 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe ExtractStructuredResumeDataJob, type: :job do
+  let(:textract_result_id) { 123 }
+  let(:service_instance) { instance_double(ExtractStructuredResumeData) }
+
+  before do
+    allow(ExtractStructuredResumeData).to receive(:new)
+      .with(textract_result_id: textract_result_id)
+      .and_return(service_instance)
+  end
+
+  describe '#perform' do
+    it 'delegates to ExtractStructuredResumeData service' do
+      allow(service_instance).to receive(:extract)
+
+      described_class.new.perform(textract_result_id)
+
+      expect(service_instance).to have_received(:extract)
+    end
+
+    context 'when service raises CustomErrorStructuredExtraction' do
+      it 're-raises the error for retry_on to catch' do
+        allow(service_instance).to receive(:extract)
+          .and_raise(CustomErrorStructuredExtraction, 'API failure')
+
+        expect do
+          described_class.new.perform(textract_result_id)
+        end.to raise_error(CustomErrorStructuredExtraction)
+      end
+    end
+
+    context 'when service raises StandardError' do
+      it 'rescues and does not re-raise' do
+        allow(service_instance).to receive(:extract)
+          .and_raise(StandardError, 'unexpected error')
+
+        expect do
+          described_class.new.perform(textract_result_id)
+        end.not_to raise_error
+      end
+    end
+  end
+
+  describe 'retry_on configuration' do
+    include ActiveJob::TestHelper
+
+    around do |example|
+      original_adapter = ActiveJob::Base.queue_adapter
+      ActiveJob::Base.queue_adapter = :test
+      example.run
+      ActiveJob::Base.queue_adapter = original_adapter
+    end
+
+    it 're-enqueues the job via retry_on when CustomErrorStructuredExtraction is raised' do
+      allow(service_instance).to receive(:extract)
+        .and_raise(CustomErrorStructuredExtraction, 'API failure')
+
+      expect do
+        described_class.perform_now(textract_result_id)
+      end.to have_enqueued_job(described_class)
+    end
+  end
+end
